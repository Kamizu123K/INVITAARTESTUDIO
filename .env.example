# ================================================================
# INVITA ARTE STUDIO v1.1.0 - CONFIGURACIÓN LOCAL Y 3 APIs
# Copia este archivo como .env. Para modo local no es obligatorio
# completar claves: el sistema utiliza respaldos locales verificables.
# ================================================================

PORT=3000
APP_BASE_URL=http://localhost:3000
APP_VERSION=1.1.0
WHATSAPP_PUBLIC_NUMBER=59174562899

# 1) SUPABASE API (servidor; no exponer service_role en el navegador)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 2) GOOGLE SHEETS API mediante cuenta de servicio
GOOGLE_SHEET_ID=
GOOGLE_SHEET_ORDERS_RANGE=Solicitudes!A:Q
GOOGLE_SHEET_RSVP_RANGE=RSVP!A:I
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# En Windows conserva los \n. El servidor los convierte a saltos reales.
GOOGLE_PRIVATE_KEY=""

# 3) WHATSAPP CLOUD API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=59174562899
# Utiliza la versión habilitada en tu aplicación de Meta.
META_GRAPH_API_VERSION=v23.0
WHATSAPP_SEND_TO_CLIENT=false

# Seguridad y operación
API_RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info
